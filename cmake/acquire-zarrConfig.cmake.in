@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Find required dependencies for acquire-zarr
find_dependency(nlohmann_json CONFIG REQUIRED)
find_dependency(blosc CONFIG REQUIRED)
find_dependency(Crc32c CONFIG REQUIRED)
find_dependency(zstd CONFIG REQUIRED)
find_dependency(yaml-cpp CONFIG REQUIRED)
find_dependency(aws-crt-cpp CONFIG REQUIRED)
find_dependency(OpenMP REQUIRED)

# Include the targets file
include("${CMAKE_CURRENT_LIST_DIR}/acquire-zarrTargets.cmake")

check_required_components(acquire-zarr)